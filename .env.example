# Annotated reference for every required variable. There are NO defaults anywhere in
# code or compose - a missing value fails fast.
#
#   run.sh <cmd>            uses .env        (production; git-ignored, you create it)
#   run.sh -local <cmd>     uses .env.local  (localhost; git-ignored - copy from .env.local.example)
#
# CLI flags always win over the env file (e.g. `run.sh -local ai --port 9001`).

# ---- PostgreSQL container ----
POSTGRES_USER=inbox
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smart_inbox
POSTGRES_PORT=5432

# ---- Backend -> DB ----
# Inside compose the DB host is the service name `postgres`; bare-metal it is your host.
DB_URL=jdbc:postgresql://postgres:5432/smart_inbox
DB_USER=inbox
DB_PASSWORD=change-me

# ---- Mailbox (IMAP test account; app password) ----
MAIL_ENABLED=true
MAIL_HOST=imap.example.com
MAIL_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
MAIL_POLL_MS=15000

# ---- Backend ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
STORAGE_DIR=/app/storage
REVIEWER_ID=reviewer-1
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=2
WORKER_STUCK_SECONDS=300
MAX_ATTACHMENT_MB=25
MAX_IMPORT_REQUEST_MB=100
MAX_BODY_CHARS=200000
CORS_ALLOWED_ORIGIN=https://inbox.example.com

# ---- Backend -> AI service ----
AI_SERVICE_URL=http://ai-service:8000
AI_TIMEOUT_SECONDS=180
AI_CONNECT_TIMEOUT_SECONDS=10

# ---- AI service ----
AI_HOST=0.0.0.0
AI_PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PROMPT_VERSION=v6
PDF_PAGE_CAP=120
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_RPM=60
OPENAI_MAX_RETRIES=5
CACHE_TTL_SECONDS=2592000

# ---- Frontend ----
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4200
NGINX_PORT=80
API_BASE_URL=https://inbox.example.com

# ---- E2E tests (tests/integration) - unset means the suite skips ----
# API_BASE_URL is reused. Optional:
E2E_POLL_TIMEOUT_S=180
