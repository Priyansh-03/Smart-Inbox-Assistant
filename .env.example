# Copy to .env and fill in. Nothing is hardcoded in code or compose; every key below is required.
# Any key can also be overridden on the CLI (Spring: --key=value ; uvicorn: --host/--port). Env wins per shell.

# ---- PostgreSQL ----
POSTGRES_USER=inbox
POSTGRES_PASSWORD=
POSTGRES_DB=smart_inbox
POSTGRES_PORT=5432
# Local run (outside compose) uses these directly; compose derives DB_URL from the parts above.
DB_URL=jdbc:postgresql://postgres-host:5432/smart_inbox
DB_USER=inbox
DB_PASSWORD=

# ---- Mailbox (IMAP test account, use an app password) ----
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=993
MAIL_USER=
MAIL_PASSWORD=
MAIL_FOLDER=INBOX
MAIL_POLL_MS=15000

# ---- Backend ----
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
STORAGE_DIR=./storage
REVIEWER_ID=reviewer-1
WORKER_POLL_MS=5000
WORKER_MAX_ATTEMPTS=2
CORS_ALLOWED_ORIGIN=http://frontend-host:4200

# ---- AI service (backend -> ai) ----
AI_SERVICE_URL=http://ai-host:8000
AI_TIMEOUT_SECONDS=180

# ---- AI service process ----
AI_HOST=0.0.0.0
AI_PORT=8000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
PROMPT_VERSION=v1
PDF_PAGE_CAP=120

# ---- Frontend ----
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4200
API_BASE_URL=http://backend-host:8080
